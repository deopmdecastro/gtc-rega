    {
      "type": "wokwi-text",
      "id": "title",
      "left": 360,
      "top": -440,
      "attrs": {
        "text": "GTC Rega — Plataforma ES3N28P (ESP32-S3)\nMCP23017 espelhado em GPIO 4..12 (saídas)\nEntradas PB6/PB7 espelhadas em GPIO 13/15\nDHT22 em GPIO 21 (T/H1) e GPIO 14 (T/H2)\nStatus LED em GPIO 48"
      }
    },
    {
      "type": "wokwi-text",
      "id": "legend_sen",
      "left": -380,
      "top": -240,
      "attrs": {
        "text": "SENSORES no ESP32-S3 (DHT22)"
      }
    },
    {
      "type": "wokwi-text",
      "id": "legend_in",
      "left": -380,
      "top": 270,
      "attrs": {
        "text": "ENTRADAS PB6/PB7 (feedback 24V isolado)\nespelhadas em GPIO 13 e 15"
      }
    },
    {
      "type": "wokwi-text",
      "id": "legend_out",
      "left": 360,
      "top": -380,
      "attrs": {
        "text": "SAÍDAS (MCP PA0..PA7 + PB0)\nespelhadas em GPIO 4..12 — LEDs + relés"
      }
    },
    {
      "type": "wokwi-text",
      "id": "legend_test",
      "left": -380,
      "top": 600,
      "attrs": {
        "text": "BOTÕES DE TESTE\nEMERG (BOOT GPIO 0) → paragem imediata\nSW KM1 (GPIO 13) → simula contacto auxiliar do contator\nSW TEMP (GPIO 15) → simula relé térmico ON (bloqueia motor)"
      }
    },
