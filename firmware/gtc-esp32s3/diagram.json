    { "type": "wokwi-slide-switch", "id": "sw_temp_fb",  "left": -380, "top": 430, "attrs": { "label": "PB7 FB TÉRMICO (GPIO 15)" } },

    { "type": "wokwi-led",      "id": "led_fb_bomba", "left": -100, "top": 320, "attrs": { "color": "lime", "label": "LED KM1" } },
    { "type": "wokwi-led",      "id": "led_fb_temp",  "left": -100, "top": 430, "attrs": { "color": "red",  "label": "LED TÉRMICO" } },

