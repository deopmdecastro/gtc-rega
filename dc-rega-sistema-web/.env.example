# ─────────────────────────────────────────────────────────
# GTC Rega — Configuração do ambiente
# ─────────────────────────────────────────────────────────
#
# Copie este ficheiro para .env e ajuste conforme necessário:
#   cp .env.example .env
#
# ── Backend API URL ──
# Em produção Docker: deixe vazio (nginx faz proxy reverso)
# Em desenvolvimento local: http://localhost:3000
VITE_API_URL=

# ── Supabase (OPCIONAL) ──
# O painel funciona sem estas variáveis (usa backend Docker).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Device Token (backend) ──
# Token de autenticação para o ESP32-S3 se comunicar com o backend.
# Deve ser igual ao GTC_DEVICE_TOKEN definido em firmware/gtc-esp32s3/src/config.h
# Deixe vazio para desabilitar a autenticação (não recomendado em produção).
DEVICE_TOKEN=

# ── Data directory ──
# Diretório onde o backend persiste estado (zones, eventos, layout).
# Default: /data (produção Docker) ou ./data (desenvolvimento local)
DATA_DIR=./data

# ── Port ──
# Porta onde o servidor Express escuta. Default: 3000
PORT=3000
