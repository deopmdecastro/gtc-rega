# Supabase (OPCIONAL)
# O painel funciona sem estas variáveis (registo de eventos fica em memória).
# Para persistir o histórico numa base de dados Supabase, copie este ficheiro
# para ".env.local" e preencha os valores do seu projeto Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
